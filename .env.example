# MongoDB Atlas connection string. Format:
#   mongodb://<user>:<password>@<shard-hosts>/?ssl=true&replicaSet=<replica-set>&authSource=admin
# (Atlas → Database → Connect → "Connect your application" gives this URI;
# replace <password> with the database user's password, URL-encoded.)
# The same value goes into the Vercel project's env vars for deploys.
# NOTE: Atlas must allow network access from anywhere (0.0.0.0/0) — see
# README → Deployment — because Vercel has no fixed egress IPs.
DATABASE_URL="mongodb://user:password@ac-xxxxx-shard-00-00.example.mongodb.net:27017,ac-xxxxx-shard-00-01.example.mongodb.net:27017,ac-xxxxx-shard-00-02.example.mongodb.net:27017/?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin"

# Password for the /login page gate. CHANGE THIS.
APP_PASSWORD="taskflow-change-me"

# Token for GET /api/report and POST /api/bootstrap (Muse nightly automation).
# Generate: openssl rand -hex 24
REPORT_TOKEN="replace-with-a-long-random-token"
